{
  "version": 1,
  "note": "One lead schema for every Imperial site. The forms post these field names; netlify/functions/lib/core.js reads them. A site sets only its site key and its default division. Names and allowed values are final; a field not listed here is ignored by the core.",
  "sites": {
    "ihg": {"name": "Imperial Holdings Group", "defaultDivision": "group"},
    "citizenship": {"name": "Imperial Citizenship", "defaultDivision": "citizenship", "tbc": "TO CONFIRM: site goes live on the shared core"},
    "partners-club": {"name": "Imperial Partners Club", "defaultDivision": "partners-club", "tbc": "TO CONFIRM: site goes live on the shared core"},
    "private-office": {"name": "Imperial Private Office", "defaultDivision": "private-office", "tbc": "TO CONFIRM: site goes live on the shared core"},
    "real-estate": {"name": "Imperial Real Estate", "defaultDivision": "real-estate", "tbc": "TO CONFIRM: site goes live on the shared core"},
    "academy": {"name": "Imperial Academy", "defaultDivision": "academy", "tbc": "TO CONFIRM: site goes live on the shared core"}
  },
  "divisions": ["citizenship", "private-office", "partners-club", "academy", "real-estate", "group"],
  "forms": {
    "enquiry": {"label": "Enquiry card on the home page and the division pages, also used by the programme fit check", "divisionField": "division"},
    "contact": {"label": "Three step contact form", "divisionField": "about"},
    "interest": {"label": "Real Estate register interest", "defaultDivision": "real-estate"},
    "guide": {"label": "Citizenship guide request (name, email, consent)", "defaultDivision": "citizenship", "leadSource": "guide"}
  },
  "fields": {
    "name": {"type": "text", "required": true, "max": 200, "where": "every form"},
    "email": {"type": "email", "required": true, "max": 254, "where": "every form"},
    "phone": {"type": "phone", "max": 40, "where": "enquiry, contact", "note": "With country code. Normalised to E.164 when possible."},
    "country": {"type": "text", "max": 120, "where": "enquiry, contact, interest", "note": "Country of residence, free text. Written to the Pipedrive person field only when it matches an option label."},
    "msg": {"type": "text", "max": 5000, "where": "every form except guide"},
    "consent": {"type": "text", "where": "every form", "note": "The checkbox posts 'yes'."},
    "audience": {"type": "enum", "values": ["clients", "partners", "institutions"], "where": "enquiry, contact"},
    "audience_resolved": {"type": "enum", "values": ["clients", "partners", "institutions"], "where": "hidden, every form"},
    "division": {"type": "enum", "values": ["citizenship", "private-office", "partners-club", "academy", "real-estate", "group"], "where": "enquiry, guide (hidden)"},
    "about": {"type": "enum", "values": ["citizenship", "private-office", "partners-club", "academy", "real-estate", "group"], "where": "contact step 1"},
    "routed_to": {"type": "text", "max": 120, "where": "hidden"},
    "interests": {"type": "text", "max": 500, "where": "contact (hidden)"},
    "interest": {"type": "text", "max": 200, "where": "interest"},
    "pref": {"type": "text", "max": 40, "where": "contact step 2"},
    "nationality": {"type": "text", "max": 200, "where": "contact step 2, enquiry", "note": "One or more, free text. Written to the Pipedrive person field only when it matches an option label; otherwise it goes in the note."},
    "for_whom": {"type": "enum", "values": ["myself", "family", "client"], "where": "contact step 2, enquiry"},
    "timeline": {"type": "enum", "values": ["3m", "3-12m", "exploring"], "labels": {"3m": "Within 3 months", "3-12m": "3 to 12 months", "exploring": "Just exploring for now"}, "where": "contact step 3, enquiry"},
    "budget": {"type": "enum", "values": ["under-250k", "250k-500k", "500k-1m", "over-1m", "undisclosed"], "labels": {"under-250k": "Under US$250,000", "250k-500k": "US$250,000 to 500,000", "500k-1m": "US$500,000 to 1 million", "over-1m": "Over US$1 million", "undisclosed": "I would rather not say yet"}, "where": "contact step 3, enquiry (optional)"},
    "firm": {"type": "text", "max": 200, "where": "Partners Club choice or partners audience"},
    "profession": {"type": "text", "max": 200, "where": "Partners Club choice or partners audience"},
    "re_intent": {"type": "enum", "values": ["buy", "rent"], "where": "Real Estate choice"},
    "re_area": {"type": "text", "max": 200, "where": "Real Estate choice"},
    "lead_source": {"type": "enum", "values": ["website", "programme-fit", "guide"], "where": "hidden", "default": "website"},
    "quiz_answers": {"type": "text", "max": 4000, "where": "hidden, programme fit only", "note": "JSON string of the five answers."},
    "site": {"type": "enum", "values": ["ihg", "citizenship", "partners-club", "private-office", "real-estate", "academy"], "where": "hidden, from config.site", "default": "ihg"},
    "cf-turnstile-response": {"type": "text", "max": 4000, "where": "hidden, only when Turnstile is on"},
    "company_url": {"type": "text", "where": "honeypot, must stay empty"},
    "source": {"type": "text", "max": 200, "where": "hidden tracking"},
    "medium": {"type": "text", "max": 200, "where": "hidden tracking"},
    "campaign": {"type": "text", "max": 200, "where": "hidden tracking"},
    "utm_source": {"type": "text", "max": 200, "where": "hidden tracking"},
    "utm_medium": {"type": "text", "max": 200, "where": "hidden tracking"},
    "utm_campaign": {"type": "text", "max": 200, "where": "hidden tracking"},
    "utm_content": {"type": "text", "max": 200, "where": "hidden tracking"},
    "utm_term": {"type": "text", "max": 200, "where": "hidden tracking"},
    "gclid": {"type": "text", "max": 200, "where": "hidden tracking"},
    "fbclid": {"type": "text", "max": 200, "where": "hidden tracking"},
    "landing": {"type": "text", "max": 1000, "where": "hidden tracking"},
    "referrer": {"type": "text", "max": 1000, "where": "hidden tracking"},
    "page": {"type": "text", "max": 1000, "where": "hidden tracking"}
  },
  "tracking": ["source", "medium", "campaign", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "fbclid", "landing", "referrer", "page"],
  "score": {
    "note": "Points add up; the band is written as the Pipedrive label, a [HOT] or [WARM] title prefix, and in the note.",
    "timeline": {"3m": 4, "3-12m": 2, "exploring": 0},
    "budget": {"over-1m": 3, "500k-1m": 2, "250k-500k": 1, "under-250k": 0, "undisclosed": 0},
    "divisionFit": {"single": 1, "group": 0},
    "source": {"referral": 2, "organic": 1, "paid": 0},
    "bands": {"hot": 6, "warm": 3, "exploringWarm": 5},
    "exploringCap": "When the timeline is 'exploring' or missing, the band is at most warm, and warm then needs exploringWarm points."
  }
}
