# Netlify headers. Generated into dist/_headers by build/build.js from build/headers.template: edit the template.
# The build fills in the pre-launch X-Robots-Tag line (dropped when it runs with LAUNCH=1), the sha256 of every inline
# script in index.html, and the extra CSP origins that GA4, Cloudflare Turnstile and the video players (Vimeo or Mux) need, only when those keys
# or video ids are set in data.js. See build/README.md.
/*
{{robots}}  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' {{hashes}}{{script}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:{{img}}; font-src 'self'; connect-src 'self'{{connect}}; frame-src {{frame}}; media-src 'self'{{media}}; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Fonts and photographs never change name, so cache them hard. CSS and JS carry a version query string and use
# Netlify's default revalidation, so edits show at once. Prerendered HTML is revalidated on every request: the
# /*.html rule below matches only direct requests for the .html files; the clean urls (/about and so on) do not end
# in .html and get Netlify's default for HTML, which is this same value.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/logos/*
  Cache-Control: public, max-age=2592000
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/journal/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
